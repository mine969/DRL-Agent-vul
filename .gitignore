# === Python ===
__pycache__/
*.py[cod]
*.pyo
*.so

# === Virtual environments ===
.venv/
.venv*/
venv/
# NOTE: env/ is source code (WebSecurityGym targets), not a virtualenv

# === Environment & secrets ===
.env
.env.local
.env.*.local

# === IDEs & editors ===
.idea/
.claude/
*.swp
*.swo
*~

# === OS artifacts ===
.DS_Store
Thumbs.db
nul

# === Windows office temp files ===
~$*.xlsx
~$*.doc
~$*.docx
~$*.ppt
~$*.pptx
*.tmp
* - Copy.*

# === Databases ===
*.db
*.sqlite
*.sqlite3

# === Logs & runtime output ===
*.log
logs/
evaluation/

# === Generated scan reports (runtime output) ===
reports/
uploads/
downloads/

# === Large reference PDFs / Office docs ===
*.pdf
*.docx
*.xlsx

# === ML model checkpoints ===
# All .pth files and checkpoint dirs are ignored by default.
# To publish the latest checkpoint: git add -f checkpoints/<name>.pth
checkpoints/
models/
checkpoints_backup*/
*.pth
*.h5
*.pkl
*.model

# === Personal AI memory (session notes) ===
.remember/

# === Proxy list (fetched at runtime) ===
proxies.txt
